{
  "description": "Request schemas from Subi-neko Publish API 1.0.0; openapi.yaml is authoritative.",
  "components": {
    "schemas": {
      "TitlePublish": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "media_type": {
                  "const": "movie"
                }
              }
            },
            "then": {
              "properties": {
                "episode_structure": {
                  "const": "FLAT"
                },
                "episode_order": {
                  "properties": {
                    "kind": {
                      "const": "standard"
                    }
                  }
                }
              }
            }
          }
        ],
        "properties": {
          "mappings": {
            "items": {
              "$ref": "#/components/schemas/ProviderMapping"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Mappings",
            "type": "array"
          },
          "media_type": {
            "enum": [
              "tv",
              "movie"
            ],
            "title": "Media Type",
            "type": "string"
          },
          "episode_structure": {
            "enum": [
              "SEASONED",
              "FLAT"
            ],
            "title": "Episode Structure",
            "type": "string"
          },
          "episode_order": {
            "$ref": "#/components/schemas/EpisodeOrder"
          },
          "title_english": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title English",
            "type": "string"
          },
          "title_romaji": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title Romaji"
          },
          "year": {
            "anyOf": [
              {
                "maximum": 9999,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "original_language": {
            "pattern": "^[a-z]{2,3}$",
            "title": "Original Language",
            "type": "string"
          },
          "description_english": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description English"
          }
        },
        "required": [
          "mappings",
          "media_type",
          "episode_structure",
          "episode_order",
          "title_english",
          "original_language"
        ],
        "title": "TitlePublish",
        "type": "object"
      },
      "EpisodeOrder": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "group_id": {
                  "type": "null"
                }
              }
            },
            "if": {
              "properties": {
                "kind": {
                  "const": "episode_group"
                }
              }
            },
            "then": {
              "properties": {
                "group_id": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "group_id"
              ]
            }
          }
        ],
        "properties": {
          "provider": {
            "default": "tmdb",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "title": "Provider",
            "type": "string"
          },
          "kind": {
            "enum": [
              "standard",
              "episode_group"
            ],
            "title": "Kind",
            "type": "string"
          },
          "group_id": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Group Id"
          }
        },
        "required": [
          "kind"
        ],
        "title": "EpisodeOrder",
        "type": "object"
      },
      "ProviderMapping": {
        "additionalProperties": false,
        "properties": {
          "provider": {
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "title": "Provider",
            "type": "string"
          },
          "media_type": {
            "enum": [
              "tv",
              "movie"
            ],
            "title": "Media Type",
            "type": "string"
          },
          "external_id": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "\\S",
            "title": "External Id",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "media_type",
          "external_id"
        ],
        "title": "ProviderMapping",
        "type": "object"
      },
      "EpisodePublish": {
        "additionalProperties": false,
        "anyOf": [
          {
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          },
          {
            "properties": {
              "mappings": {
                "minItems": 1
              }
            },
            "required": [
              "mappings"
            ]
          },
          {
            "properties": {
              "publisher_key": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "publisher_key"
            ]
          }
        ],
        "properties": {
          "id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Id"
          },
          "mappings": {
            "items": {
              "$ref": "#/components/schemas/ProviderMapping"
            },
            "maxItems": 100,
            "title": "Mappings",
            "type": "array"
          },
          "publisher_key": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Publisher Key"
          },
          "episode_number": {
            "maximum": 2147483647,
            "minimum": 0,
            "title": "Episode Number",
            "type": "integer"
          },
          "name_english": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Name English"
          }
        },
        "required": [
          "episode_number"
        ],
        "title": "EpisodePublish",
        "type": "object"
      },
      "SeasonMapping": {
        "additionalProperties": false,
        "properties": {
          "provider": {
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "title": "Provider",
            "type": "string"
          },
          "media_type": {
            "enum": [
              "tv",
              "movie"
            ],
            "title": "Media Type",
            "type": "string"
          },
          "external_id": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "\\S",
            "title": "External Id",
            "type": "string"
          },
          "kind": {
            "default": "season",
            "enum": [
              "season",
              "episode_group_subgroup"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "media_type",
          "external_id"
        ],
        "title": "SeasonMapping",
        "type": "object"
      },
      "SeasonPublish": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Id"
          },
          "mappings": {
            "items": {
              "$ref": "#/components/schemas/SeasonMapping"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Mappings",
            "type": "array"
          },
          "season_number": {
            "maximum": 2147483647,
            "minimum": 0,
            "title": "Season Number",
            "type": "integer"
          },
          "name_english": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Name English"
          },
          "year": {
            "anyOf": [
              {
                "maximum": 9999,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/EpisodePublish"
            },
            "maxItems": 1000,
            "title": "Episodes",
            "type": "array"
          }
        },
        "required": [
          "mappings",
          "season_number"
        ],
        "title": "SeasonPublish",
        "type": "object"
      },
      "FlatPublish": {
        "additionalProperties": false,
        "properties": {
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/EpisodePublish"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Episodes",
            "type": "array"
          }
        },
        "required": [
          "episodes"
        ],
        "title": "FlatPublish",
        "type": "object"
      },
      "SubtitleUpload": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "release_label": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Release Label",
            "type": "string"
          },
          "changelog": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Changelog"
          }
        },
        "required": [
          "file",
          "release_label"
        ],
        "title": "SubtitleUpload",
        "type": "object"
      }
    }
  }
}
